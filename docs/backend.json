{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user of the DOCFLOW application.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "email", "createdAt"]
    },
    "PublicAIResult": {
      "title": "PublicAIResult",
      "type": "object",
      "description": "A generated AI result shared publicly via a slug.",
      "properties": {
        "shareSlug": { "type": "string" },
        "creatorId": { "type": "string" },
        "toolName": { "type": "string" },
        "generatedContent": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isPubliclyShareable": { "type": "boolean" }
      },
      "required": ["shareSlug", "creatorId", "generatedContent"]
    },
    "UsageLog": {
      "title": "UsageLog",
      "type": "object",
      "description": "Metadata log for a document transformation or AI operation.",
      "properties": {
        "userId": { "type": "string" },
        "toolUsed": { "type": "string" },
        "requestTimestamp": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["SUCCESS", "FAILED"] }
      },
      "required": ["userId", "toolUsed", "requestTimestamp", "status"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous", "google.com"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/UserProfile" },
      "description": "User profiles."
    },
    "/users/{userId}/usageLogs/{logId}": {
      "schema": { "$ref": "#/backend/entities/UsageLog" },
      "description": "User-specific operation logs."
    },
    "/public_ai_results/{slug}": {
      "schema": { "$ref": "#/backend/entities/PublicAIResult" },
      "description": "Publicly shared AI tool results."
    },
    "/usageLogs/{logId}": {
      "schema": { "$ref": "#/backend/entities/UsageLog" },
      "description": "Global audit registry for administration."
    },
    "/system/config": {
      "schema": { "type": "object" },
      "description": "Global system parameters and maintenance toggles."
    }
  }
}