rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * DOCFLOW Industrial Security Rules
     * 
     * Core Philosophy: This ruleset enforces a strict user-ownership model while providing 
     * a verified administrative tunnel for system intelligence.
     * 
     * Key Security Decisions:
     * 1. Authorization Independence: Every user-scoped document contains a 'userId' field.
     * 2. Administrative Clearance: The Master Admin (office.contact.sufian@gmail.com) 
     *    has global read/list access for system oversight.
     * 3. Immutable Audits: Usage logs are protected from modification by users.
     */

    // --- Helper Functions ---

    /** @description Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Verifies ownership and ensures the document exists for state-changing operations. */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    /** @description Checks if the user is the verified Master Administrator. */
    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "office.contact.sufian@gmail.com";
    }

    // --- Collection Rules ---

    /**
     * @description Controls access to global subscription plan definitions.
     */
    match /subscriptions/{subscriptionId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if false;
    }

    /**
     * @description Secures the root user profile document.
     * Admins can list and manage profiles for system oversight.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if (isExistingOwner(userId) && request.resource.data.id == resource.data.id) || isAdmin();
      allow delete: if isAdmin(); 
    }

    /**
     * @description Secures metadata for files uploaded or generated by the user.
     */
    match /users/{userId}/files/{fileId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if (isExistingOwner(userId) && request.resource.data.userId == userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Secures records of AI tools and PDF operations.
     */
    match /users/{userId}/operations/{operationId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if (isExistingOwner(userId) && request.resource.data.userId == userId) || isAdmin();
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @description Secures logs used for tracking API usage and rate limiting.
     */
    match /users/{userId}/usageLogs/{usageLogId} {
      allow get, list: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update, delete: if isAdmin();
    }
  }
}