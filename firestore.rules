
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * DocuFlow Intelligence Security Rules
     *
     * CORE PHILOSOPHY:
     * Strict user ownership with master-admin override for intelligence monitoring
     * and account provisioning.
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * isAdmin() checks for either:
     * 1. The hardcoded master admin email (emergency access/bootstrap).
     * 2. An existence marker in the roles_admin collection.
     */
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "office.contact.sufian@gmail.com" ||
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid))
      );
    }

    function isOwnerOrAdmin(userId) {
      return isOwner(userId) || isAdmin();
    }

    // --- Collection Rules ---

    /**
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow get: if isOwnerOrAdmin(userId);
      allow list: if isAdmin();
      // Allow creation if the user is self-registering OR an admin is provisioning them.
      allow create: if isOwner(userId) || isAdmin();
      // Allow update if the user is modifying their own record OR an admin is managing them.
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @path /roles_admin/{adminId}
     */
    match /roles_admin/{adminId} {
      allow get: if isOwnerOrAdmin(adminId);
      allow list: if isAdmin();
      // Master admin can always create/update markers. Self-creation allowed for master email.
      allow create, update: if (isOwner(adminId) && request.auth.token.email == "office.contact.sufian@gmail.com") || isAdmin();
      allow delete: if isAdmin();
    }

    /**
     * @path /users/{userId}/files/{fileId}
     */
    match /users/{userId}/files/{fileId} {
      allow get, list: if isOwnerOrAdmin(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(userId) || isAdmin();
    }

    /**
     * @path /users/{userId}/operations/{operationId}
     */
    match /users/{userId}/operations/{operationId} {
      allow get, list: if isOwnerOrAdmin(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isAdmin();
    }

    /**
     * @path /conversion_presets/{presetId}
     */
    match /conversion_presets/{presetId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
