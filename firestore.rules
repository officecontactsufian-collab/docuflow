
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * DOCFLOW Industrial Security Rules
     * Administrative Clearance Protocol v3.2
     * Hardened for Master Admin UID: NNEu5gbMlVRKd094f3PuPO23jow2
     */

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == "NNEu5gbMlVRKd094f3PuPO23jow2" ||
        request.auth.token.email == "office.contact.sufian@gmail.com"
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Administrative & System Level Rules ---

    match /system/{allPaths=**} {
      allow read, write: if isAdmin();
    }

    match /usageLogs/{logId} {
      // Allow any user to log their activity to the global registry
      allow create: if isSignedIn();
      // Only Admin can view or manage the global audit sequence
      allow get, list, update, delete: if isAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // --- User Identity Lattice Rules ---

    match /users/{userId} {
      // Master Admin has absolute clearance over the identity registry
      allow get, list, write: if isAdmin();
      
      // Standard owners manage their own profiles
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && request.resource.data.id == userId;

      // Recursive Sub-Collection Protection
      match /files/{fileId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /operations/{operationId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /usageLogs/{usageLogId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }
  }
}
