rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * DOCFLOW Professional Security Rules v2.5
     * 
     * Core Philosophy: 
     * "Trust Nothing, Verify Everything." This ruleset enforces strict user ownership
     * and administrative clearance protocols across the entire intelligence lattice.
     */

    // --- Global Helper Functions ---

    /** Checks if the request is from a signed-in user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Checks if the authenticated user matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Checks if the user is the owner and the document exists. */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /** Checks for master administrative clearance. */
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "office.contact.sufian@gmail.com" || 
        request.auth.uid == "NNEu5gbMlVRKd094f3PuPO23jow2"
      );
    }

    // --- Collection Rules ---

    /**
     * @description System configuration node. Restricted to administrative override.
     */
    match /system/{docId} {
      allow get: if isSignedIn();
      allow write: if isAdmin();
    }

    /**
     * @description Public AI Result Sharing. 
     * Allows universal read for shared links, but restricted creation.
     */
    match /public_ai_results/{slug} {
      allow get: if true; // Public access for shared slugs
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.creatorId == request.auth.uid);
    }

    /**
     * @description Global Audit Registry.
     * Authenticated users can append logs; only admins can audit.
     */
    match /usageLogs/{logId} {
      allow create: if isSignedIn();
      allow get, list, delete: if isAdmin();
    }

    /**
     * @description Identity Lattice. Users can only manage their own profile and sub-registries.
     */
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId) || isAdmin();
      allow delete: if isAdmin();

      /**
       * @description Private User Sub-collections.
       */
      match /documents/{documentId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if (isExistingOwner(userId) && request.resource.data.userId == resource.data.userId) || isAdmin();
        allow delete: if isExistingOwner(userId) || isAdmin();
      }

      match /processingJobs/{jobId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && request.resource.data.userId == userId;
        allow update: if (isExistingOwner(userId) && request.resource.data.userId == resource.data.userId) || isAdmin();
        allow delete: if isExistingOwner(userId) || isAdmin();
      }

      match /usageLogs/{logId} {
        allow get, list, create: if isOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      match /operations/{opId} {
        allow get, list, create: if isOwner(userId) || isAdmin();
        allow update, delete: if isAdmin();
      }
    }
  }
}