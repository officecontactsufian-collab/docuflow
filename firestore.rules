rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * DOCFLOW Intelligence Security Rules - STRICT ADMIN SOVEREIGNTY
     */

    // --- Helper Functions ---

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == "office.contact.sufian@gmail.com";
    }

    // --- Collection Rules ---

    /**
     * @path /users/{userId}
     * Strictly restricted to the Master Admin for system intelligence.
     */
    match /users/{userId} {
      allow read, write: if isAdmin();
    }

    /**
     * @path /roles_admin/{adminId}
     * Internal markers for privilege escalation.
     */
    match /roles_admin/{adminId} {
      allow read, write: if isAdmin();
    }

    /**
     * Public tools processing (Simulated persistence)
     * Note: Most tools process in-memory, but metadata tracking is allowed for owners.
     */
    match /users/{userId}/files/{fileId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /users/{userId}/operations/{operationId} {
      allow read, write: if isAdmin() || (isSignedIn() && request.auth.uid == userId);
    }

    match /conversion_presets/{presetId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
