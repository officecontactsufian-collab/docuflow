
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /users/{userId}/documents/{documentId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update, delete: if isOwner(userId);
    }

    match /users/{userId}/usageLogs/{logId} {
      allow create: if isOwner(userId);
      allow get, list: if isOwner(userId);
    }

    match /usageLogs/{logId} {
      allow create: if isSignedIn();
      allow get, list: if isSignedIn() && (request.auth.token.email == 'office.contact.sufian@gmail.com' || request.auth.uid == 'NNEu5gbMlVRKd094f3PuPO23jow2');
    }

    match /system/config {
      allow get: if true;
      allow update: if isSignedIn() && (request.auth.token.email == 'office.contact.sufian@gmail.com' || request.auth.uid == 'NNEu5gbMlVRKd094f3PuPO23jow2');
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow delete: if isSignedIn() && (request.auth.token.email == 'office.contact.sufian@gmail.com' || request.auth.uid == 'NNEu5gbMlVRKd094f3PuPO23jow2');
    }

    match /public_ai_results/{shareSlug} {
      allow get: if true;
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow list: if false;
    }
  }
}
