rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * DOCFLOW Professional Security Rules
     * 
     * CORE PHILOSOPHY:
     * This ruleset implements a strict User-Ownership model with an administrative 
     * override for the Master Admin (office.contact.sufian@gmail.com).
     */

    // --- Helper Functions ---

    /** @description Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** @description Checks if the authenticated user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** @description Checks if the user is the owner and the document currently exists. */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    /** @description Checks if the authenticated user has Master Admin clearance. */
    function isMasterAdmin() {
      return isSignedIn() && request.auth.token.email == 'office.contact.sufian@gmail.com';
    }

    // --- Collection Rules ---

    /**
     * @description Rules for the UserProfile entity.
     * Users manage their own profiles. Master Admin has global read/delete clearance.
     */
    match /users/{userId} {
      allow get, list: if isOwner(userId) || isMasterAdmin();
      allow create: if (isOwner(userId) && request.resource.data.id == userId) || isMasterAdmin();
      allow update: if (isExistingOwner(userId) && request.resource.data.id == resource.data.id) || isMasterAdmin();
      allow delete: if isExistingOwner(userId) || isMasterAdmin();

      /**
       * @description Rules for File metadata.
       */
      match /files/{fileId} {
        allow get, list: if isOwner(userId) || isMasterAdmin();
        allow create: if (isOwner(userId) && request.resource.data.userId == userId) || isMasterAdmin();
        allow update: if (isExistingOwner(userId) && request.resource.data.userId == resource.data.userId) || isMasterAdmin();
        allow delete: if isExistingOwner(userId) || isMasterAdmin();
      }

      /**
       * @description Rules for ProcessingJobs.
       */
      match /jobs/{jobId} {
        allow get, list: if isOwner(userId) || isMasterAdmin();
        allow create: if (isOwner(userId) && request.resource.data.userId == userId) || isMasterAdmin();
        allow update: if (isExistingOwner(userId) && request.resource.data.userId == resource.data.userId) || isMasterAdmin();
        allow delete: if isExistingOwner(userId) || isMasterAdmin();
      }
    }

    // Default deny for any paths not explicitly matched above.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}