rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * PDF Spark Security Rules
     *
     * CORE PHILOSOPHY:
     * This ruleset implements a strict user-ownership model where users manage their own files and operations
     * within their own dedicated data trees. It utilizes path-based authorization to ensure that access is
     * granted only to the owner of the data or a verified administrator.
     */

    // --- Helper Functions ---

    /** Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Checks if the authenticated user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Checks if the user exists in the admin roles collection. */
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    /** Combined check for ownership or administrative privileges. */
    function isOwnerOrAdmin(userId) {
      return isOwner(userId) || isAdmin();
    }

    /** Validates that a document exists and the user is the owner. */
    function isExistingOwner(userId) {
      return resource != null && isOwner(userId);
    }

    // --- Collection Rules ---

    /**
     * @path /users/{userId}
     */
    match /users/{userId} {
      allow get: if isOwnerOrAdmin(userId);
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isAdmin();
    }

    /**
     * @path /roles_admin/{adminId}
     * UPDATED: Allows the designated admin email to create their own marker.
     * Allows self-retrieval to bootstrap admin status.
     */
    match /roles_admin/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(adminId) && request.auth.token.email == "office.contact.sufian@gmail.com";
      allow update, delete: if isAdmin();
    }

    /**
     * @path /users/{userId}/files/{fileId}
     */
    match /users/{userId}/files/{fileId} {
      allow get, list: if isOwnerOrAdmin(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId) || isAdmin();
    }

    /**
     * @path /users/{userId}/operations/{operationId}
     */
    match /users/{userId}/operations/{operationId} {
      allow get, list: if isOwnerOrAdmin(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isAdmin();
    }

    /**
     * @path /conversion_presets/{presetId}
     */
    match /conversion_presets/{presetId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}